# Ywon / Ywoom provider configuration. Never commit/upload a populated .env,
# send keys in chat, or expose them in browser/mobile code.
# Fill only the lines you use; leave the rest empty. File is git-ignored (.env, .env.*).
# Use dedicated restricted test keys + billing alerts/alerts per provider.

# ── Ywon Architect (Director) ───────────────────────────────────────────
# Основной мозг Домового/Архитектора. Один core, все адаптеры (трей, web, companion) ходят сюда.
# Модель: Claude Opus 5.5 (capability text.director). Ключ читается только сервером/worker-ом, не в git/chat.
ANTHROPIC_API_KEY=

# ── Дешёвые агенты / рутина ───────────────────────────────────────────────
# Парсинг, теги, промпты, субтитры, QA-воркеры. Можно через тот же Anthropic (Haiku/Sonnet)
# или через OpenAI — выбери один путь. Если оставляешь пустым, код fallback не вызовет провайдера.
OPENAI_API_KEY=
# Альтернативный шлюз: если хочешь гнать Anthropic/OpenAI/Google через один ключ/endpoint.
# Не обязателен, если есть прямые ключи выше. Не логировать промпты ради -1% скидки.
OPENROUTER_API_KEY=

CLEAN_API_KEY=cc_Z69MZPp4Xrgrm3m7Y3gvmO01NmsNnmk8I9P1oQaUrZqXJZJq
BASE_URL=https://cleanapis.com/v1


