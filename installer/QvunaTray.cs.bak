using System.Diagnostics;
using System.Drawing;
using System.IO;
using System.Reflection;
using System.Text.RegularExpressions;
using System.Windows.Forms;
using Microsoft.Win32;
using System.Runtime.InteropServices;
namespace YwonTray {
 static class Program {
  static string dir = "";
  static string target = "";
  static Process server = null;
  static string url = null;
 [DllImport("kernel32.dll")] static extern bool AllocConsole();
 [DllImport("kernel32.dll")] static extern bool AttachConsole(int pid);
  static NotifyIcon tray = null;
  static bool minimized = false;
  static Form webForm = null;
  static Control webViewCtrl = null;
  static string lastUrl = null;
  static bool appWindowShown = false;
  static readonly object windowLock = new object();
  static Process factoryServer = null;
  static string factoryUrl = null;
  public static string DefaultDir(){
   return Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),"Ywon","Ywon Companion");
  }
  static void RunSetupAsr(){
   try{
    string cmd = Path.Combine(dir, "SETUP-ASR.cmd");
    if(!File.Exists(cmd)){ MessageBox.Show("SETUP-ASR.cmd not found in "+dir,"Ywon Companion",MessageBoxButtons.OK,MessageBoxIcon.Warning); return; }
    ProcessStartInfo psi = new ProcessStartInfo();
    psi.FileName = "cmd.exe";
    psi.Arguments = "/c start \"\" \""+cmd+"\"";
    psi.WorkingDirectory = dir;
    psi.UseShellExecute = true;
    Process.Start(psi);
   }catch(Exception ex){ MessageBox.Show("Setup ASR failed:\n"+ex.Message,"Ywon Companion",MessageBoxButtons.OK,MessageBoxIcon.Error); }
  }
  static int DoCheck(){
   try{
    string d = DefaultDir();
    bool dirOk = Directory.Exists(d);
    string YwonCmd = Path.Combine(d, "Ywon.cmd");
    string startCmd = Path.Combine(d, "START.cmd");
    string uninstallExe = Path.Combine(d, "uninstall.exe");
    string startMenu = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Programs), "Ywon");
    string desktop = Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory);
    string msg = "Ywon Companion check:\n";
    msg += (dirOk?"OK":"MISS")+" installDir: "+d+"\n";
    msg += (File.Exists(YwonCmd)?"OK":"MISS")+" Ywon.cmd: "+YwonCmd+"\n";
    msg += (File.Exists(startCmd)?"OK":"MISS")+" START.cmd: "+startCmd+"\n";
    msg += (File.Exists(uninstallExe)?"OK":"MISS")+" uninstall.exe: "+uninstallExe+"\n";
    msg += (File.Exists(Path.Combine(startMenu,"Ywon.lnk"))?"OK":"MISS")+" Start/Ywon.lnk\n";
    msg += (File.Exists(Path.Combine(desktop,"Ywon Companion.lnk"))?"OK":"MISS")+" Desktop lnk\n";
    try{ using(var k=Registry.CurrentUser.OpenSubKey(@"Software\Microsoft\Windows\CurrentVersion\Uninstall\YwonCompanion")){ if(k!=null){ var v=k.GetValue("DisplayName"); msg+="OK HKCU Uninstall DisplayName: "+v+"\n"; } else msg+="MISS HKCU Uninstall\\YwonCompanion\n"; } }catch(Exception ex){ msg+="ERR Uninstall key: "+ex.Message+"\n"; }
    try{ using(var k=Registry.CurrentUser.OpenSubKey(@"Software\Microsoft\Windows\CurrentVersion\Run")){ if(k!=null){ var v=k.GetValue("YwonCompanion"); if(v!=null) msg+="OK HKCU Run YwonCompanion: "+v+"\n"; else msg+="(absent) HKCU Run YwonCompanion - OFF by default\n"; } } }catch(Exception ex){ msg+="ERR Run key: "+ex.Message+"\n"; }
    if(url!=null) msg+="URL: "+url+"\n"; else msg+="URL: (server not yet ready)\n";
    try{
     string portableNode = @"E:\Ywoom-ASR\node-portable\node.exe";
     string localNode = Path.Combine(dir, "node-portable", "node.exe");
     if(File.Exists(portableNode)) msg+="OK portable Node: "+portableNode+"\n";
     else if(File.Exists(localNode)) msg+="OK local Node: "+localNode+"\n";
     else msg+="(info) portable Node not yet installed - will use system Node 24\n";
     string model = @"E:\Ywoom-ASR\vosk-model-small-ru-0.22\am\final.mdl";
     if(File.Exists(model)) msg+="OK Vosk model: vosk-model-small-ru-0.22\n";
     else msg+="(info) Vosk model not yet installed - run SETUP-ASR.cmd\n";
     bool wv2dll = File.Exists(Path.Combine(dir, "Microsoft.Web.WebView2.WinForms.dll"));
     msg+=(wv2dll?"OK":"(info)")+" WebView2 dll: "+(wv2dll?"found":"not bundled - fallback to embedded/external")+"\n";
     string eBase = @"E:\Ywoom-ASR";
     msg+="OK path length "+eBase.Length+" <=120\n";
    }catch{}
    try{ Console.WriteLine(msg); Console.Out.Flush(); }catch{}
    if(Environment.UserInteractive){
     try{ if(!Console.IsOutputRedirected) MessageBox.Show(msg,"Ywon Companion",MessageBoxButtons.OK,MessageBoxIcon.Information); }catch{}
    }
    return dirOk?0:2;
   }catch(Exception ex){ try{ Console.Error.WriteLine(ex.ToString()); }catch{} MessageBox.Show(ex.ToString(),"Ywon check",MessageBoxButtons.OK,MessageBoxIcon.Error); return 2; }
  }
  static Process StartNodeServer(string tgt, string workingDir, Action<string> onLine){
   try{
    string file = tgt; string args = "";
    if(tgt.EndsWith(".cmd", StringComparison.OrdinalIgnoreCase)){ file="cmd.exe"; args="/c \"\"" + tgt + "\"\""; }
    ProcessStartInfo psi = new ProcessStartInfo();
    psi.FileName=file; psi.Arguments=args; psi.WorkingDirectory=workingDir;
    psi.UseShellExecute=false; psi.CreateNoWindow=true; psi.RedirectStandardOutput=true; psi.RedirectStandardError=true; psi.WindowStyle=ProcessWindowStyle.Hidden;
    Process p = Process.Start(psi);
    if(p!=null){
     p.OutputDataReceived += (s,e)=>{ if(e.Data!=null) onLine(e.Data); };
     p.ErrorDataReceived += (s,e)=>{ if(e.Data!=null) onLine(e.Data); };
     p.BeginOutputReadLine(); p.BeginErrorReadLine();
    }
    return p;
   }catch(Exception ex){ MessageBox.Show("\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u0435\u0440\u0432\u0435\u0440:\n"+ex.Message+" target="+tgt, "Ywon",MessageBoxButtons.OK,MessageBoxIcon.Error); return null; }
  }
  static void StartServer(){
   StartCompanion();
   StartFactory();
  }
  static void StartCompanion(){
   server = StartNodeServer(target, dir, OnOutput);
  }
  static void OnFactoryOutput(string data){
   if(String.IsNullOrEmpty(data)) return;
   try{
    System.Diagnostics.Debug.WriteLine("OnFactoryOutput: "+data.Substring(0,Math.Min(200,data.Length)));
    var m = Regex.Match(data, @"http://127\.0\.0\.1:\d+");
    if(m.Success){
     string u=m.Value; if(u==factoryUrl) return; factoryUrl=u;
     // CRITICAL: OnFactoryOutput runs on background thread (OutputDataReceived), MUST marshal to UI thread
     lock(windowLock){
      if(appWindowShown && factoryForm!=null && !factoryForm.IsDisposed) return;
     }
     if(!minimized){
      try{
       if(factoryForm!=null && !factoryForm.IsDisposed) return;
       // Always marshal ShowFactoryWindow to UI thread — calling directly from background thread hangs WebView2
       // tray is NotifyIcon (no Invoke), use Application.OpenForms[0] as marshal
       {
        Form marshal=null; try{ if(Application.OpenForms.Count>0) marshal=Application.OpenForms[0]; }catch{}
        if(marshal!=null && marshal.InvokeRequired){ try{ marshal.BeginInvoke(new Action(()=> ShowFactoryWindow(u))); return; }catch{} }
        if(marshal!=null){ ShowFactoryWindow(u); return; }
       }
       ShowFactoryWindow(u);
      }catch{ try{ ShowFactoryWindow(u); }catch{} }
     } else {
      try{ tray.ShowBalloonTip(3000, "Ywon — Завод", "Завод запущен: "+u, ToolTipIcon.Info); }catch{}
     }
    }
   }catch(Exception ex){ try{ System.Diagnostics.Debug.WriteLine("OnFactoryOutput err: "+ex.Message); }catch{} }
  }
  static void StartFactory(){
   try{
    string f = Path.Combine(dir, "FACTORY.cmd");
    if(!File.Exists(f)) return;
    factoryServer = StartNodeServer(f, dir, OnFactoryOutput);
   }catch{}
  }
  // Fallback timer for factory url guess when stdout missed
  static Timer factoryUrlPoll = null;
  static void OnOutput(string data){
   if(String.IsNullOrEmpty(data)) return;
   try{
    var m = Regex.Match(data, @"http://127\.0\.0\.1:\d+");
    if(m.Success){
     string newUrl = m.Value;
     if(newUrl==url) return;
     url = newUrl;
     // companion window: only if user \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0438\u043B\u0438 factoryUrl \u0435\u0449\u0435 \u043D\u0435\u0442 \u0438 minimized==false \u043D\u0435 \u0441\u043F\u0430\u043C\u0438\u043C \u0432\u0442\u043E\u0440\u044B\u043C \u043E\u043A\u043D\u043E\u043C
     lock(windowLock){
      // factory window \u0443\u0436\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043D \u2014 companion \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043A\u043B\u0438\u043A\u0443 OpenBrowser, \u043D\u0435 \u0430\u0432\u0442\u043E
      if(factoryForm!=null && !factoryForm.IsDisposed) return;
      if(appWindowShown && lastUrl==url) return;
      // \u0435\u0441\u043B\u0438 factoryUrl \u0443\u0436\u0435 \u0435\u0441\u0442\u044C \u2014 \u043D\u0435 \u0441\u043F\u0430\u043C\u0438\u043C \u0432\u0442\u043E\u0440\u044B\u043C \u043E\u043A\u043D\u043E\u043C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u043C
      if(factoryUrl!=null) return;
      lastUrl = url;
      appWindowShown = true;
     }
     if(!minimized){
      try{
       Form f = null;
       try{ if(Application.OpenForms.Count>0) f=Application.OpenForms[0]; }catch{}
       if(f!=null && f.InvokeRequired) f.BeginInvoke(new Action(()=> ShowWebWindow(url)));
       else if(webForm!=null && webForm.InvokeRequired) webForm.BeginInvoke(new Action(()=> ShowWebWindow(url)));
       else ShowWebWindow(url);
      }catch{ try{ ShowWebWindow(url);}catch{} }
     } else {
      try{ tray.ShowBalloonTip(3000, "Ywon Companion", "\u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0437\u0430\u043F\u0443\u0449\u0435\u043D: "+url, ToolTipIcon.Info); }catch{}
     }
    }
   }catch{}
  }
  static Form factoryForm = null;
  static Control factoryView = null;
  static string factoryLastUrl = null;
  // FIX: WebView2 requires async initialization. Sync Source set hangs on some machines.
  // Create form immediately, show it, then init WebView2 async and navigate when ready.
  static void ShowFactoryWindow(string u){
   try{
    if(factoryForm!=null && !factoryForm.IsDisposed){ try{ factoryForm.WindowState=FormWindowState.Normal; factoryForm.Show(); factoryForm.BringToFront(); factoryForm.Activate(); }catch{} return; }
    Form f = new Form(); f.Text="Ywoom — Завод / Студия / Подписки"; f.Width=1240; f.Height=820; f.StartPosition=FormStartPosition.CenterScreen; f.Icon=SystemIcons.Application;
    // Show loading placeholder immediately so window is responsive
    Label loading = new Label(); loading.Text = "Загружаю Ywoom Завод...\n"+u+"\nПодожди секунду."; loading.Dock=DockStyle.Fill; loading.TextAlign=ContentAlignment.MiddleCenter; loading.Font=new Font("Segoe UI",12); f.Controls.Add(loading);
    StatusStrip st = new StatusStrip(); ToolStripStatusLabel lb=new ToolStripStatusLabel(); lb.Text="Загрузка WebView2 • "+u; lb.Spring=true; st.Items.Add(lb);
    ToolStripStatusLabel btnOpen=new ToolStripStatusLabel("Открыть в браузере"); btnOpen.IsLink=true; btnOpen.Click+=(s2,e2)=>{ try{ Process.Start(new ProcessStartInfo(u){UseShellExecute=true}); }catch{} }; st.Items.Add(btnOpen); f.Controls.Add(st);
    factoryForm=f; factoryLastUrl=u;
    f.FormClosed+=(s,e)=>{ factoryForm=null; factoryView=null; };
    f.Show(); f.BringToFront(); f.Activate(); Application.DoEvents();
    // Now init WebView2 — after form is visible, on UI thread but non-blocking
    Control view=null; string lastErr=""; bool isWv=false;
    try{
     Assembly asm=null;
     string[] probes=new string[]{ Path.Combine(dir,"Microsoft.Web.WebView2.WinForms.dll"), Path.Combine(Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location)??dir,"Microsoft.Web.WebView2.WinForms.dll") };
     foreach(var p2 in probes){ if(File.Exists(p2)){ try{ asm=Assembly.LoadFrom(p2); break; }catch(Exception ex){ lastErr=ex.Message; } } }
     if(asm==null){ try{ asm=Assembly.Load("Microsoft.Web.WebView2.WinForms"); }catch(Exception ex){ lastErr=ex.Message; } }
     if(asm!=null){
      Type t2=asm.GetType("Microsoft.Web.WebView2.WinForms.WebView2");
      if(t2!=null){
       view=(Control)Activator.CreateInstance(t2); view.Dock=DockStyle.Fill;
       // Add to form — WebView2 needs parent before Source
       f.Controls.Add(view); view.BringToFront();
       // Use CoreWebView2InitializationCompleted event for async init, then Navigate
       try{
        var coreProp = t2.GetProperty("CoreWebView2");
        var navMethod = t2.GetMethod("EnsureCoreWebView2Async", new Type[]{});
        if(navMethod!=null){
         object taskObj = navMethod.Invoke(view, null);
         if(taskObj!=null){
          // Don't block — wait async via continuation
          dynamic dt = taskObj;
          dt.ContinueWith(new Action<System.Threading.Tasks.Task>((task)=>{
           f.BeginInvoke(new Action(()=>{
            try{
             if(task.IsFaulted){ lastErr+=" Ensure fault: "+task.Exception.InnerException.Message; ShowFactoryFallback(f, u, lastErr, loading, st, lb); return; }
             var sp=t2.GetProperty("Source");
             if(sp!=null){ sp.SetValue(view,new Uri(u),null); isWv=true; lb.Text="WebView2 • "+u; }
             else {
              var core = coreProp.GetValue(view,null);
              if(core!=null){ var nv=core.GetType().GetMethod("Navigate", new Type[]{typeof(string)}); if(nv!=null){ nv.Invoke(core,new object[]{u}); isWv=true; lb.Text="WebView2 • "+u; } else lastErr+=" no Navigate"; }
              else lastErr+=" core null after init";
             }
             loading.Visible=false;
             factoryView=view;
            }catch(Exception ex){ lastErr+=" post-init: "+ex.Message; ShowFactoryFallback(f, u, lastErr, loading, st, lb); }
           }), System.Threading.Tasks.TaskScheduler.FromCurrentSynchronizationContext());
          }));
         } else {
          var sp=t2.GetProperty("Source"); if(sp!=null){ sp.SetValue(view,new Uri(u),null); isWv=true; lb.Text="WebView2 • "+u; loading.Visible=false; factoryView=view; }
         }
        } else {
         var sp=t2.GetProperty("Source"); if(sp!=null){ sp.SetValue(view,new Uri(u),null); isWv=true; lb.Text="WebView2 • "+u; loading.Visible=false; factoryView=view; }
         else lastErr+=" no Source prop";
        }
       }catch(Exception ex){ lastErr+=" init: "+ex.Message; ShowFactoryFallback(f, u, lastErr, loading, st, lb); return; }
      } else { lastErr+=" WebView2 type not found"; ShowFactoryFallback(f, u, lastErr, loading, st, lb); return; }
     } else { lastErr+=" WebView2 assembly not found"; ShowFactoryFallback(f, u, lastErr, loading, st, lb); return; }
    }catch(Exception ex){ lastErr=ex.Message; ShowFactoryFallback(f, u, lastErr, loading, st, lb); return; }
    if(!isWv && view!=null){
     // Still loading — will navigate via continuation, keep loading visible briefly then hide
     Timer hideLoading=new Timer(); hideLoading.Interval=4000; hideLoading.Tick+=(s,e)=>{ hideLoading.Stop(); hideLoading.Dispose(); try{ loading.Visible=false; if(factoryView==null) factoryView=view; }catch{} }; hideLoading.Start();
    } else if(isWv) { loading.Visible=false; factoryView=view; }
    f.Update();
   }catch(Exception ex){ try{ MessageBox.Show("Factory window error:\n"+ex.ToString(), "Ywoom",MessageBoxButtons.OK,MessageBoxIcon.Error); }catch{} }
  }
  static void ShowFactoryFallback(Form f, string u, string lastErr, Label loading, StatusStrip st, ToolStripStatusLabel lb){
   try{
    loading.Text="WebView2 не удалось запустить.\n\nОшибка: "+lastErr.Trim()+"\nDLLs: "+(File.Exists(Path.Combine(dir,"Microsoft.Web.WebView2.WinForms.dll"))?"found":"MISS")+" / "+(File.Exists(Path.Combine(dir,"WebView2Loader.dll"))?"loader found":"loader MISS")+"\n\nНажми кнопку ниже.\nURL: "+u;
    loading.Font=new Font("Consolas",9);
    Button btnOpen2=new Button(); btnOpen2.Text="Открыть в браузере → "+u; btnOpen2.Dock=DockStyle.Bottom; btnOpen2.Height=36;
    btnOpen2.Click+=(s2,e2)=>{ try{ Process.Start(new ProcessStartInfo(u){UseShellExecute=true}); }catch{} };
    f.Controls.Add(btnOpen2); btnOpen2.BringToFront();
    lb.Text="ОШИБКА WebView2 • "+lastErr.Trim().Substring(0,Math.Min(80,lastErr.Trim().Length));
   }catch{}
  }
  static void ShowWebWindow(string u){
   try{
    lock(windowLock){ if(webForm!=null && !webForm.IsDisposed && webViewCtrl!=null){ NavigateWebWindow(u); return; } if(appWindowShown && lastUrl==u && webForm!=null && !webForm.IsDisposed) return; }
    if(webForm!=null && !webForm.IsDisposed){ NavigateWebWindow(u); return; }
    Form f = new Form(); f.Text = "Ywon \u2014 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0438\u043B\u043E\u0442"; f.Width = 1120; f.Height = 760; f.StartPosition=FormStartPosition.CenterScreen; f.Icon=SystemIcons.Application;
    Label loading2=new Label(); loading2.Text="\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u044E \u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A...\n"+u; loading2.Dock=DockStyle.Fill; loading2.TextAlign=ContentAlignment.MiddleCenter; loading2.Font=new Font("Segoe UI",12); f.Controls.Add(loading2);
    StatusStrip st2=new StatusStrip(); ToolStripStatusLabel lb2=new ToolStripStatusLabel(); lb2.Text="\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430 WebView2 \u2022 "+u; lb2.Spring=true; st2.Items.Add(lb2);
    ToolStripStatusLabel btnOpen2=new ToolStripStatusLabel("\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435"); btnOpen2.IsLink=true; btnOpen2.Click+=(s2,e2)=>{ try{ Process.Start(new ProcessStartInfo(u){UseShellExecute=true}); }catch{} }; st2.Items.Add(btnOpen2); f.Controls.Add(st2);
    webForm=f;
    f.FormClosed+=(s,e)=>{ webForm=null; webViewCtrl=null; lock(windowLock){ appWindowShown=false; } };
    f.Show(); f.BringToFront(); f.Activate(); Application.DoEvents();
    Control view=null; bool isWv=false; string lastErr="";
    try{
     Assembly asm=null;
     string[] probes=new string[]{ Path.Combine(dir,"Microsoft.Web.WebView2.WinForms.dll"), Path.Combine(Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location)??dir,"Microsoft.Web.WebView2.WinForms.dll") };
     foreach(var p2 in probes){ if(File.Exists(p2)){ try{ asm=Assembly.LoadFrom(p2); break; }catch(Exception ex){ lastErr=ex.Message; } } }
     if(asm==null){ try{ asm=Assembly.Load("Microsoft.Web.WebView2.WinForms"); }catch(Exception ex){ lastErr=ex.Message; } }
     if(asm!=null){ Type t2=asm.GetType("Microsoft.Web.WebView2.WinForms.WebView2"); if(t2!=null){ view=(Control)Activator.CreateInstance(t2); view.Dock=DockStyle.Fill; f.Controls.Add(view); view.BringToFront();
       try{ var taskObj=t2.GetMethod("EnsureCoreWebView2Async", new Type[]{}).Invoke(view, null); if(taskObj!=null){ dynamic dt=taskObj; dt.ContinueWith(new Action<System.Threading.Tasks.Task>((task)=>{ f.BeginInvoke(new Action(()=>{ try{ if(task.IsFaulted){ lastErr+=" Ensure: "+task.Exception.InnerException.Message; lb2.Text="\u041E\u0428\u0418\u0411\u041A\u0410 WebView2 \u2022 "+lastErr.Substring(0,Math.Min(80,lastErr.Length)); loading2.Text="WebView2 \u043E\u0448\u0438\u0431\u043A\u0430: "+lastErr+"\nURL: "+u; return; } var sp=t2.GetProperty("Source"); if(sp!=null){ sp.SetValue(view,new Uri(u),null); isWv=true; lb2.Text="WebView2 \u2022 "+u; } loading2.Visible=false; webViewCtrl=view; }catch(Exception ex){ lastErr+=" post: "+ex.Message; } })); }), System.Threading.Tasks.TaskScheduler.FromCurrentSynchronizationContext()); } else { var sp=t2.GetProperty("Source"); if(sp!=null){ sp.SetValue(view,new Uri(u),null); isWv=true; lb2.Text="WebView2 \u2022 "+u; } loading2.Visible=false; webViewCtrl=view; }
       }catch(Exception ex){ lastErr+=" init: "+ex.Message; }
     } }
    }catch(Exception ex){ lastErr=ex.Message; }
    if(view==null){
     loading2.Text="WebView2 \u043D\u0435 \u0441\u0442\u0430\u0440\u0442\u0430\u043D\u0443\u043B: "+lastErr.Trim()+"\nURL: "+u; loading2.Font=new Font("Consolas",9);
     Button b=new Button(); b.Text="\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435 \u2192 "+u; b.Dock=DockStyle.Bottom; b.Height=36; b.Click+=(s2,e2)=>{ try{ Process.Start(new ProcessStartInfo(u){UseShellExecute=true}); }catch{} }; f.Controls.Add(b); b.BringToFront();
     lb2.Text="\u041E\u0428\u0418\u0411\u041A\u0410 WebView2 \u2022 "+lastErr.Substring(0,Math.Min(80,lastErr.Length));
    } else if(isWv) { Timer hl=new Timer(); hl.Interval=3000; hl.Tick+=(s,e)=>{ hl.Stop(); hl.Dispose(); try{ loading2.Visible=false; if(webViewCtrl==null) webViewCtrl=view; }catch{} }; hl.Start(); }
   }catch(Exception ex){ try{ MessageBox.Show("WebView error:\n"+ex.Message+"\nURL: "+u+"\n", "Ywon",MessageBoxButtons.OK,MessageBoxIcon.Warning); }catch{} }
  }
  static void NavigateWebWindow(string u){
   try{
    if(webForm==null || webForm.IsDisposed){ ShowWebWindow(u); return; }
    if(webViewCtrl==null){ ShowWebWindow(u); return; }
    try{ if(webForm.WindowState==FormWindowState.Minimized) webForm.WindowState=FormWindowState.Normal; webForm.Show(); webForm.BringToFront(); webForm.Activate(); }catch{}
    Type t2 = webViewCtrl.GetType(); var src = t2.GetProperty("Source");
    if(src!=null && src.CanWrite){ try{ src.SetValue(webViewCtrl, new Uri(u), null); return; }catch{} }
    if(webViewCtrl is WebBrowser){ try{ ((WebBrowser)webViewCtrl).Navigate(u); return; }catch{} }
    try{ var cp = t2.GetProperty("CoreWebView2"); if(cp!=null){ var core=cp.GetValue(webViewCtrl,null); if(core!=null){ var nv=core.GetType().GetMethod("Navigate", new Type[]{ typeof(string) }); if(nv!=null){ nv.Invoke(core,new object[]{u}); return; } } } }catch{}
    ShowWebWindow(u);
   }catch(Exception ex){ try{ MessageBox.Show("Navigate failed:\n"+ex.Message, "Ywon", MessageBoxButtons.OK, MessageBoxIcon.Warning); }catch{} }
  }
  static void OpenFactoryWindow(){
   try{
    string u = factoryUrl ?? "http://127.0.0.1:3000";
    // If factory not yet ready, try companion url as fallback for now, but prefer factory
    if(factoryUrl==null && url!=null) u = url;
    if(factoryForm!=null && !factoryForm.IsDisposed){ try{ factoryForm.WindowState=FormWindowState.Normal; factoryForm.Show(); factoryForm.BringToFront(); factoryForm.Activate(); }catch{} return; }
    if(factoryUrl!=null){ ShowFactoryWindow(factoryUrl); return; }
    if(url!=null){ ShowWebWindow(url); return; }
    // No url yet: try guess 3000, then companion
    ShowFactoryWindow(u);
    return;
   }catch(Exception ex){ MessageBox.Show("Не удалось открыть Завод:\n"+ex.Message, "Ywon",MessageBoxButtons.OK,MessageBoxIcon.Warning); }
  }
  static void OpenBrowser(){
   try{
    lock(windowLock){ if(appWindowShown && webForm!=null && !webForm.IsDisposed){ NavigateWebWindow(url); return; } }
    if(url!=null){
     if(webForm!=null && !webForm.IsDisposed){
      try{
       if(webForm.InvokeRequired) webForm.BeginInvoke(new Action(()=> NavigateWebWindow(url)));
       else NavigateWebWindow(url);
       return;
      }catch{}
     }
     lock(windowLock){ if(appWindowShown) return; appWindowShown=true; lastUrl=url; }
     ShowWebWindow(url);
     if(webForm==null){ lock(windowLock){ appWindowShown=false; } try{ Process.Start(new ProcessStartInfo(url){UseShellExecute=true}); }catch{} }
    }
    else {
     string fallback = "http://127.0.0.1:0 \u2014 \u0441\u0435\u0440\u0432\u0435\u0440 \u0435\u0449\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F, \u043F\u043E\u0434\u043E\u0436\u0434\u0438 2 \u0441\u0435\u043A \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438.";
     MessageBox.Show(fallback+"\n\u041F\u0430\u043F\u043A\u0430: "+dir+"\nURL: "+(url??"(\u043D\u0435\u0442)"), "Ywon Companion",MessageBoxButtons.OK,MessageBoxIcon.Information);
    }
   }catch(Exception ex){ lock(windowLock){ appWindowShown=false; } MessageBox.Show("\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0431\u0440\u0430\u0443\u0437\u0435\u0440:\n"+ex.Message+"\nURL: "+(url??"(\u043D\u0435\u0442)"), "Ywon Companion",MessageBoxButtons.OK,MessageBoxIcon.Error); }
  }
  static System.Threading.Mutex singleMutex = null;
  [STAThread]
  static int Main(string[] args){
   bool flagMinimized = false;
   bool checkOnly = false;
   bool help = false;
   foreach(var a in args){
    if(a=="--minimized") flagMinimized=true;
    else if(a=="--check") checkOnly=true;
    else if(a=="--help"||a=="-h") help=true;
   }
   minimized = flagMinimized;
   if(help||checkOnly){ try{ AllocConsole(); }catch{} try{ AttachConsole(-1); }catch{} }
   if(help){ string h="YwonTray.exe - tray for Ywon Companion\\n  --minimized  start hidden, balloon on url\\n  --check      verify shortcuts/registry\\n  --help       this help\\n  WebView2 embedded window with fallback to external browser"; try{ Console.WriteLine(h); Console.Out.Flush(); }catch{} try{ if(Environment.UserInteractive && !Console.IsOutputRedirected) MessageBox.Show(h,"Ywon Companion",MessageBoxButtons.OK,MessageBoxIcon.Information); }catch{} return 0; }
   if(checkOnly){ return DoCheck(); }
   bool created;
   try{
    singleMutex = new System.Threading.Mutex(true, "Global\\YwonCompanionSingleInstance", out created);
    if(!created){
     MessageBox.Show("Ywon уже запущен — ищи иконку в трее (возле часов). Если не видно — нажми стрелку ^ и открой его оттуда.", "Ywon Companion", MessageBoxButtons.OK, MessageBoxIcon.Information);
     return 0;
    }
   }catch{}
   dir = Path.GetDirectoryName(System.Reflection.Assembly.GetExecutingAssembly().Location) ?? "";
   // Прямой запуск сервера без Ywon.cmd-рекурсии: START.cmd через cmd /c чтобы поймать URL
   string startCmd2 = Path.Combine(dir, "START.cmd");
   string YwonCmd2 = Path.Combine(dir, "Ywon.cmd");
   // Трей всегда стартует START.cmd напрямую, не Ywon.cmd (Ywon.cmd = start detached + рекурсия)
   if(File.Exists(startCmd2)) target = startCmd2;
   else if(File.Exists(YwonCmd2)) target = YwonCmd2;
   else target = startCmd2;
   Application.EnableVisualStyles();
   Application.SetCompatibleTextRenderingDefault(false);
   tray = new NotifyIcon();
   tray.Icon = SystemIcons.Application;
   tray.Text = "Ywon Companion \u2014 \u043b\u043E\u043A\u0430\u043b\u044C\u043D\u044B\u0439 \u043f\u0438\u043b\u043E\u0442";
   tray.Visible = true;
   ContextMenuStrip menu = new ContextMenuStrip();
   var itemFactory = new ToolStripMenuItem("\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0417\u0430\u0432\u043E\u0434 (Ywoom)");
   var itemCompanion = new ToolStripMenuItem("\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A (\u0430\u0443\u0434\u0438\u043E)");
   var itemCheck = new ToolStripMenuItem("\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443");
   var itemSetup = new ToolStripMenuItem("\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430 ASR (SETUP-ASR)");
   var itemExit = new ToolStripMenuItem("\u0412\u044B\u0445\u043E\u0434");
   menu.Items.Add(itemFactory);
   menu.Items.Add(itemCompanion);
   menu.Items.Add(itemCheck);
   menu.Items.Add(itemSetup);
   menu.Items.Add(new ToolStripSeparator());
   menu.Items.Add(itemExit);
   tray.ContextMenuStrip = menu;
   tray.DoubleClick += (s,e)=> OpenFactoryWindow();
   itemFactory.Click += (s,e)=>{ if(factoryUrl!=null) ShowFactoryWindow(factoryUrl); else OpenFactoryWindow(); };
   itemCompanion.Click += (s,e)=>{ if(url!=null) ShowWebWindow(url); else OpenBrowser(); };
   // WebView2: inline window handled via ShowWebWindow
   itemCheck.Click += (s,e)=> DoCheck();
   itemSetup.Click += (s,e)=> RunSetupAsr();
   itemExit.Click += (s,e)=> { try{ if(factoryForm!=null && !factoryForm.IsDisposed) factoryForm.Close(); }catch{} try{ if(webForm!=null && !webForm.IsDisposed) webForm.Close(); }catch{} tray.Visible=false; try{ if(server!=null && !server.HasExited) server.Kill(); }catch{} try{ if(factoryServer!=null && !factoryServer.HasExited) factoryServer.Kill(); }catch{} try{ if(singleMutex!=null){ singleMutex.ReleaseMutex(); singleMutex.Dispose(); singleMutex=null; } }catch{} Application.Exit(); };
   tray.BalloonTipClicked += (s,e)=> OpenFactoryWindow();
   StartServer();
   // Fallback: if stdout parsing missed factory url, try fixed 127.0.0.1:3000 after 2.5s
   factoryUrlPoll = new Timer(); factoryUrlPoll.Interval=2500; factoryUrlPoll.Tick+=(s,e)=>{
    factoryUrlPoll.Stop();
    lock(windowLock){ if(appWindowShown) return; }
    if(factoryUrl==null){
     factoryUrl="http://127.0.0.1:3000";
     if(!minimized) OpenFactoryWindow();
    }
   }; factoryUrlPoll.Start();
   Timer poll = new Timer(); poll.Interval=900; poll.Tick+=(s,e)=>{
    if(factoryUrl!=null || url!=null){ poll.Stop(); lock(windowLock){ if(appWindowShown) return; } if(!minimized) OpenFactoryWindow(); }
    else if(server!=null && server.HasExited && factoryServer!=null && factoryServer.HasExited){ poll.Stop(); factoryUrlPoll.Stop(); MessageBox.Show("Локальный сервер завершился до старта. Проверь что Node 24 установлен и файлы не повреждены.\nПопробуй запустить FACTORY.cmd / START.cmd вручную для диагностики.", "Ywon Companion",MessageBoxButtons.OK,MessageBoxIcon.Warning); }
   }; poll.Start();
   if(!minimized){
    Timer t = new Timer(); t.Interval=1800; t.Tick+=(s,e)=>{ t.Stop(); lock(windowLock){ if(appWindowShown) return; } if(factoryUrl!=null || url!=null) OpenFactoryWindow(); else { try{ tray.ShowBalloonTip(2500, "Ywon Companion", "Запускаю Завод…", ToolTipIcon.Info); }catch{} } }; t.Start();
   }
   Application.Run();
   tray.Visible=false;
   try{ if(server!=null && !server.HasExited) server.Kill(); }catch{}
   try{ if(factoryServer!=null && !factoryServer.HasExited) factoryServer.Kill(); }catch{}
   try{ if(factoryForm!=null && !factoryForm.IsDisposed) factoryForm.Close(); }catch{}
   try{ if(webForm!=null && !webForm.IsDisposed) webForm.Close(); }catch{}
   try{ if(singleMutex!=null){ singleMutex.ReleaseMutex(); singleMutex.Dispose(); singleMutex=null; } }catch{}
   return 0;
  }
 }
}
